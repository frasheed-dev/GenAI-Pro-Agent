# ==============================================================================
# GenAI Pro Agent - Environment Configuration Template
# ==============================================================================

# Core Execution Mode
# False = Saves post text and images locally in drafts/
# True  = Dispatches live payload to configured webhooks
AUTONOMOUS_MODE=false

# ------------------------------------------------------------------------------
# 1. LLM Brain & Fallback Providers
# ------------------------------------------------------------------------------
# Primary LLM: Google Gemini Developer API (Free Tier or Paid)
# Get a key at: https://aistudio.google.com/
GEMINI_API_KEY="your_gemini_api_key_here"

# Secondary LLM Fallback: Hugging Face Serverless Inference API (Free)
# Automatically engaged when Gemini encounters 429 quota exhaustion or prepayment depletion.
# Models used: Llama-3.1-8B-Instruct, Qwen2.5-Coder-32B, Mistral-7B
# Get a free token at: https://huggingface.co/settings/tokens
HF_TOKEN="your_huggingface_token_here"

# ------------------------------------------------------------------------------
# 2. Distribution & Webhooks
# ------------------------------------------------------------------------------
# Make.com Custom Webhook URL
# Routes multi-channel payloads to LinkedIn, Facebook, and Instagram
MAKE_WEBHOOK_URL="https://hook.eu2.make.com/your_webhook_id"

# ------------------------------------------------------------------------------
# 3. Image Hosting (Required for Instagram Graph API)
# ------------------------------------------------------------------------------
# Hosting provider: "imgbb" (recommended for CI/CD), "dropbox", or "catbox" (local testing only)
IMAGE_HOST="imgbb"

# Free key from: https://api.imgbb.com/
IMGBB_API_KEY="your_imgbb_api_key_here"

# Optional: Dropbox token if IMAGE_HOST is set to "dropbox"
DROPBOX_ACCESS_TOKEN=""

# ------------------------------------------------------------------------------
# 4. Optional Direct API Tokens (if bypassing Make.com)
# ------------------------------------------------------------------------------
LINKEDIN_ACCESS_TOKEN=""
LINKEDIN_ORG_ID=""
FACEBOOK_PAGE_ID=""
FACEBOOK_PAGE_ACCESS_TOKEN=""
